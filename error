    <!-- =========================
         SLIDER JAVASCRIPT
    ========================== -->

    <script>

        function slideCollection(direction) {

            const slider =
                document.getElementById("collectionSlider");

            const card =
                slider.querySelector(".collection-card");

            const cardWidth =
                card.offsetWidth + 35;

            slider.scrollBy({

                left: direction * cardWidth,

                behavior: "smooth"

            });

        }

    </script>


